FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN python -m pip install \
    --no-cache-dir \
    "fastapi>=0.141.1" \
    "uvicorn[standard]>=0.52.4" \
    "pydantic>=2.12,<3" \
    "requests>=2.34.2"

COPY local_llm /app/local_llm

RUN useradd \
    --uid 10001 \
    --create-home \
    appuser

USER 10001:10001

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "local_llm.api.main:app", "--host", "0.0.0.0", "--port", "8000"]